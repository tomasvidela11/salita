rules_version = '2';

// Reglas para la demo de Salita: cualquiera que tenga el link puede leer y escribir,
// pero solo en las colecciones que usa la app. No cargar datos reales.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coleccion}/{id} {
      allow read, write: if coleccion in ['config', 'comunicados', 'consultas', 'actividades', 'stock', 'reportes', 'avisosDireccion', 'eventos'];
    }
  }
}
